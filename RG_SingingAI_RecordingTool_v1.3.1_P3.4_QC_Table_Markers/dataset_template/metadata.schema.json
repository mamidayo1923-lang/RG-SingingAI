{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RG Singing AI recording metadata",
  "type": "object",
  "required": [
    "metadata_schema_version",
    "created_at",
    "speaker_id",
    "session_id",
    "take_id",
    "audio",
    "alignment"
  ],
  "properties": {
    "metadata_schema_version": {
      "const": "1.0.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "speaker_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9]{2}$"
    },
    "take_id": {
      "type": "string",
      "minLength": 1
    },
    "audio": {
      "type": "object",
      "required": [
        "path",
        "sample_rate",
        "channels",
        "subtype",
        "duration_sec",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sample_rate": {
          "const": 44100
        },
        "channels": {
          "const": 1
        },
        "subtype": {
          "const": "PCM_24"
        },
        "duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": true
    },
    "alignment": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_available",
            "midi_event_reference_pending_audio_alignment",
            "manually_verified"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
